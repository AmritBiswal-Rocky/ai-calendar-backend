# ──────────────────────────────────────────────
#  🔌 Backend origin (Flask + Socket.IO)
# ──────────────────────────────────────────────
VITE_BACKEND_URL=http://127.0.0.1:5000

# ──────────────────────────────────────────────
#  🔐 Firebase Configuration (Frontend)
# ──────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ──────────────────────────────────────────────
#  🗄️ Supabase Configuration
# ──────────────────────────────────────────────
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend (service role) - used by Flask
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_SCHEMA=public

# ──────────────────────────────────────────────
#  🔐 Firebase Admin (Backend Only)
# ──────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=backend/service_account.json

# ──────────────────────────────────────────────
#  🔐 Google OAuth (Frontend + Backend)
# ──────────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_ID=your_google_client_id
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/__/auth/handler
VITE_GOOGLE_API_KEY=your_google_api_key
VITE_GOOGLE_PROJECT_ID=your_google_project_id

# ──────────────────────────────────────────────
#  📜 Combined Google OAuth Scopes (Drive + Docs + Photos)
# ──────────────────────────────────────────────
VITE_GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/documents https://www.googleapis.com/auth/photoslibrary.appendonly https://www.googleapis.com/auth/photoslibrary.readonly

# ──────────────────────────────────────────────
#  📸 Google Photos Scopes (Photos Picker)
# ──────────────────────────────────────────────
VITE_GOOGLE_PHOTOS_SCOPES=https://www.googleapis.com/auth/photoslibrary.readonly https://www.googleapis.com/auth/photoslibrary.appendonly

# ──────────────────────────────────────────────
#  📂 Google Drive Scopes (Drive Uploads)
# ──────────────────────────────────────────────
VITE_GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/drive.readonly

# ──────────────────────────────────────────────
#  🧠 Google Cloud API (Docs + Cloud Storage)
# ──────────────────────────────────────────────
VITE_GOOGLE_DOCS_API=https://docs.googleapis.com/v1/documents
VITE_GOOGLE_STORAGE_API=https://storage.googleapis.com/upload/storage/v1

# ──────────────────────────────────────────────
#  🧰 Google Service Account and Drive
# ──────────────────────────────────────────────
GOOGLE_SERVICE_ACCOUNT_FILE=backend/service_account.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# ──────────────────────────────────────────────
#  ☁️ API Keys for Google Services (if separated)
# ──────────────────────────────────────────────
VITE_PICKER_API_KEY=your_picker_api_key
VITE_CALENDAR_API_KEY=your_calendar_api_key
VITE_DRIVE_PHOTOS_DOCS_API_KEY=your_combined_drive_photos_docs_api_key
VITE_CLOUD_STORAGE_API_KEY=your_cloud_storage_api_key

# ──────────────────────────────────────────────
#  🤖 OpenRouter API (AI chat / Deep Research / Radeles)
# ──────────────────────────────────────────────
VITE_OPENROUTER_API_KEY=your_openrouter_api_key

# ──────────────────────────────────────────────
#  🧪 Misc / Demo Variable
# ──────────────────────────────────────────────
VITE_TEST=hello
